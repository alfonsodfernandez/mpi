# ==============================================================================
# MPI-I · Plataforma de Estudio Blindada para Pablo (UFV)
# Copia este archivo a .env y cambia TODAS las contraseñas y claves antes de desplegar
# ==============================================================================

# Clave secreta para firmar tokens de sesión (genera una con: openssl rand -hex 32)
SECRET_KEY=cambia-esta-clave-secreta-con-openssl-rand-hex-32-antes-de-produccion

# Credenciales del alumno (Pablo)
PABLO_USERNAME=pablo
PABLO_PASSWORD=CambiaEstaClavePablo2026!
PABLO_DISPLAY_NAME=Pablo

# Credenciales del profesor (/admin)
ADMIN_USERNAME=profesor
ADMIN_PASSWORD=CambiaEstaClaveProfesor2026!
ADMIN_DISPLAY_NAME=Profesor MPI-I

# Puerto local expuesto por el contenedor (Nginx hará proxy inverso hacia aquí)
APP_PORT=8000

# Ruta de la base de datos SQLite persistente (dentro del contenedor /app/data)
DATABASE_URL=sqlite:////app/data/mpi_platform.db

# Duración de sesión en horas
SESSION_EXPIRE_HOURS=12

# Confianza en cabeceras de proxy inverso (X-Forwarded-For / X-Real-IP de Nginx)
TRUST_PROXY_HEADERS=true

# Dominio permitido en CORS (dejar vacío si se sirve todo desde el mismo dominio vía Nginx)
CORS_ORIGINS=
